abline(v=cutoff85.l, col='yellow', lwd=4)
abline(v=cutoff90.l, col='orange', lwd=4)
abline(v=cutoff95.l, col='red', lwd=4)
abline(v=cutoff99.l, col='magenta', lwd=4)
}
if(histogram=="yes"){
hist(dt$logit, main = paste("Histogram:", dt$scientificName[1]),
xlim = range(prediction.range.logit), breaks = seq(0, 100, 10),
col = "lightblue", border = "black", xlab = "Logit Scores")
abline(v = cutoff95, col = rgb(1, 0.5, 0, 0.7), lwd = 5)
abline(v = cutoff99, col = rgb(1, 0, 0, 0.7), lwd = 5)
}
}
write.csv(output, 'C:/Users/sok73hu/data-engineering-R/birdNET_validation_thresholds.csv', row.names=FALSE)
print(intercept)

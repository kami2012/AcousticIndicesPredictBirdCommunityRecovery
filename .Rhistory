# Load the validation data
df <- read.csv("C:/Users/sok73hu/data-engineering/birdNET_V1.4_V2.4_labels_confidence_for_computing_individual_thresholds_filtered.csv", sep = ';')
# Calculate the Logit Score
df$logit <- log(df$score / (1 - df$score))
# Split the one df in multiple dfs based on scientificName -> one df per scientificName
lst_species <- split(df, df$scientificName)
# Create an empty dataframe to store the outputs
output <- data.frame(scientificName = character(),
intercept = numeric(),
beta = numeric(),
cutoff85 = numeric(),
cutoff90 = numeric(),
cutoff95 = numeric(),
cutoff99 = numeric(), stringsAsFactors = FALSE)
# Approximate range for plotting
prediction.range.conf=seq(0,1,.001)
# Approximate range of the logit scores
prediction.range.logit=seq(-3,7,.1)
# Plotting options
logistic.plot="yes" # do you want to plot the logistic curves?
histogram="yes"      # do you want a histogram of each species' scores?
# Set up plot layout (adjust as necessary)
par(mfrow=c(2,4))
for(s in 1:length(lst_species)){
dt <- lst_species[[s]]  # Extract the dataframe for the current species
# Fit the logistic model for this species
#tmp.mod.conf=glm(outcome~score, dt, family = 'binomial')
tmp.mod.logit=glm(outcome~logit, dt, family = 'binomial')
# Generate predictions based on the fitted model
#predictions.conf <- predict(tmp.mod.conf, list(logit=prediction.range.conf), type='response')
predictions.logit <- predict(tmp.mod.logit, list(logit=prediction.range.logit), type='response')
# Extract model coefficients
intercept <- tmp.mod.logit$coefficients[1]
beta <- tmp.mod.logit$coefficients[2]
# Calculate the cutoffs
cutoff85 <- (log(0.85 / (1 - 0.85)) - intercept) / beta
cutoff90 <- (log(0.90 / (1 - 0.90)) - intercept) / beta
cutoff95 <- (log(0.95 / (1 - 0.95)) - intercept) / beta
cutoff99 <- (log(0.99 / (1 - 0.99)) - intercept) / beta
# Append the results to the output data frame
output <- rbind(output, data.frame(scientificName = dt$scientificName[1],
intercept = intercept,
beta = beta,
cutoff85 = cutoff85,
cutoff90 = cutoff90,
cutoff95 = cutoff95,
cutoff99 = cutoff99))
if(logistic.plot=="yes"){
plot(outcome~logit, dt, main=dt$scientificName[1],
xlim=range(prediction.range.logit), pch=16, cex=1.5, col=rgb(0,0,0,.2))
lines(prediction.range.logit, predictions.logit, lwd = 4, col = rgb(0, 0.75, 1, 0.5))
abline(v=cutoff85.l, col='yellow', lwd=4)
abline(v=cutoff90.l, col='orange', lwd=4)
abline(v=cutoff95.l, col='red', lwd=4)
abline(v=cutoff99.l, col='magenta', lwd=4)
}
if(histogram=="yes"){
hist(dt$logit, main = paste("Histogram:", dt$scientificName[1]),
xlim = range(prediction.range.logit), breaks = seq(0, 100, 10),
col = "lightblue", border = "black", xlab = "Logit Scores")
abline(v = cutoff95, col = rgb(1, 0.5, 0, 0.7), lwd = 5)
abline(v = cutoff99, col = rgb(1, 0, 0, 0.7), lwd = 5)
}
}
write.csv(output, 'C:/Users/sok73hu/data-engineering-R/birdNET_validation_thresholds.csv', row.names=FALSE)

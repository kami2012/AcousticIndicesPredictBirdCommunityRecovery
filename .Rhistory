# Clear the environment
rm(list = ls())
# Load the validation data
df <- read.csv("C:/Users/sok73hu/data-engineering/birdNET_V1.4_V2.4_labels_confidence_for_computing_individual_thresholds_filtered.csv", sep = ';')
# Calculate the Logit Score
df$logit <- log(df$score / (1 - df$score))
# Define the outcome variable if necessary
df$outcome <- ifelse(df$score > 0.5, 1, 0)  # Example threshold, customize based on your logic
# Split the dataframe based on scientificName
lst_species <- split(df, df$scientificName)
# Create an empty dataframe to store the outputs
output <- data.frame(scientificName = character(),
intercept = numeric(),
beta = numeric(),
cutoff85 = numeric(),
cutoff90 = numeric(),
cutoff95 = numeric(),
cutoff99 = numeric(), stringsAsFactors = FALSE)
# Approximate range for plotting
prediction.range.conf <- seq(0, 1, 0.001)
prediction.range.logit <- seq(-3, 7, 0.1)
# Plotting options
logistic.plot <- "yes"  # Option to plot logistic curves
histogram <- "yes"      # Option for histograms
# Set up plot layout
par(mfrow = c(2, 4))
# Loop through each species subset
for (s in 1:length(lst_species)) {
dt <- lst_species[[s]]  # Extract the dataframe for the current species
# Fit the logistic model for this species based on score
tmp.mod.conf <- glm(outcome ~ score, dt, family = 'binomial')
# Generate predictions based on the fitted model
predictions.conf <- predict(tmp.mod.conf, list(score = prediction.range.conf), type = 'response')
# Extract model coefficients
intercept <- tmp.mod.conf$coefficients[1]
beta <- tmp.mod.conf$coefficients[2]
# Calculate the cutoffs
cutoff85 <- (log(0.85 / (1 - 0.85)) - intercept) / beta
cutoff90 <- (log(0.90 / (1 - 0.90)) - intercept) / beta
cutoff95 <- (log(0.95 / (1 - 0.95)) - intercept) / beta
cutoff99 <- (log(0.99 / (1 - 0.99)) - intercept) / beta
# Append the results to the output data frame
output <- rbind(output, data.frame(scientificName = dt$scientificName[1],
intercept = intercept,
beta = beta,
cutoff85 = cutoff85,
cutoff90 = cutoff90,
cutoff95 = cutoff95,
cutoff99 = cutoff99))
# Plot the logistic curve if requested
if (logistic.plot == "yes") {
plot(outcome ~ score, dt, main = dt$scientificName[1],
xlim = range(prediction.range.conf), pch = 16, cex = 1.5, col = rgb(0, 0, 0, 0.2))
lines(prediction.range.conf, predictions.conf, lwd = 4, col = rgb(0, 0.75, 1, 0.5))
abline(v = cutoff85, col = 'yellow', lwd = 4)
abline(v = cutoff90, col = 'orange', lwd = 4)
abline(v = cutoff95, col = 'red', lwd = 4)
abline(v = cutoff99, col = 'magenta', lwd = 4)
}
# Plot histogram if requested
if (histogram == "yes") {
hist(dt$score, main = paste("Histogram:", dt$scientificName[1]),
xlim = range(prediction.range.conf), breaks = seq(0, 100, 10),
col = "lightblue", border = "black", xlab = "Scores")
abline(v = cutoff95, col = rgb(1, 0.5, 0, 0.7), lwd = 5)
abline(v = cutoff99, col = rgb(1, 0, 0, 0.7), lwd = 5)
}
}
# Save the output to CSV
write.csv(output, 'C:/Users/sok73hu/data-engineering-R/birdNET_validation_thresholds.csv', row.names = FALSE)
